{
  "$defs": {
    "FailureDomain": {
      "enum": [
        "plan",
        "model",
        "user_code",
        "verifier",
        "sandbox",
        "scheduler",
        "storage"
      ],
      "title": "FailureDomain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "failure_domain": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureDomain"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Digest",
      "type": "string"
    },
    "result_payload": {
      "additionalProperties": true,
      "title": "Result Payload",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "verirun.final-result/v1",
      "default": "verirun.final-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "verification_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verification Plan Digest",
      "type": "string"
    },
    "verification_plan_id": {
      "minLength": 1,
      "title": "Verification Plan Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "candidate_id",
    "verification_plan_id",
    "verification_plan_digest",
    "attempt_id",
    "result_digest",
    "result_payload",
    "committed_at"
  ],
  "title": "FinalResultRecord",
  "type": "object"
}
