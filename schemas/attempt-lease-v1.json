{
  "$defs": {
    "LeaseState": {
      "enum": [
        "active",
        "expired",
        "cancelled",
        "completed"
      ],
      "title": "LeaseState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "claimed_at": {
      "format": "date-time",
      "title": "Claimed At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "heartbeat_at": {
      "format": "date-time",
      "title": "Heartbeat At",
      "type": "string"
    },
    "lease_token": {
      "minLength": 1,
      "title": "Lease Token",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "verirun.attempt-lease/v1",
      "default": "verirun.attempt-lease/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/LeaseState"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "verification_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verification Plan Digest",
      "type": "string"
    },
    "verification_plan_id": {
      "minLength": 1,
      "title": "Verification Plan Id",
      "type": "string"
    },
    "worker_id": {
      "minLength": 1,
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "run_id",
    "task_id",
    "candidate_id",
    "verification_plan_id",
    "verification_plan_digest",
    "worker_id",
    "lease_token",
    "state",
    "claimed_at",
    "heartbeat_at",
    "expires_at"
  ],
  "title": "AttemptLease",
  "type": "object"
}
